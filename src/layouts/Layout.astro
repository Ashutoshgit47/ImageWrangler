---
import "../styles/global.css";
// Self-hosted fonts: no external requests, works fully offline
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ImageWrangler - Compress, Resize & Convert Images Offline",
  description = "A free, 100% private, client-side image tool. Compress, resize, and convert AVIF, JPG, PNG, WebP, and BMP images without uploading them to a server. Secure, fast, and privacy-first.",
} = Astro.props;

const appUrl = Astro.site?.href ?? "https://imagewrangler.pages.dev/";
const ogImageUrl = new URL("og-image.png", appUrl).href;

// FAQ Schema for SEO — mirrors the visible FAQ section
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Are my images uploaded to any server?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. ImageWrangler is strictly 100% client-side. Decoding, compression, and conversions happen in your browser memory using Web Workers and HTML5 Canvas. Your files never leave your device.",
      },
    },
    {
      "@type": "Question",
      name: "Which image formats are supported?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You can import and convert across AVIF, WebP, JPEG, PNG, and BMP.",
      },
    },
    {
      "@type": "Question",
      name: "Why use AVIF or WebP over JPEG/PNG?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "AVIF and WebP deliver superior compression efficiency, producing 30% to 50% smaller file sizes than traditional JPEG and PNG while preserving sharp visual quality.",
      },
    },
    {
      "@type": "Question",
      name: "What if my browser does not support AVIF export?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "AVIF export relies on browser canvas encoding (supported in Chrome 116+ and modern Edge). If your browser does not yet support AVIF canvas export, ImageWrangler will alert you to choose WebP or JPEG.",
      },
    },
    {
      "@type": "Question",
      name: "How does Target File Size (KB/MB) mode work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It uses an automated binary-search optimization loop across canvas compression levels (down to ±0.4% precision) to hit your target file weight without guesswork.",
      },
    },
    {
      "@type": "Question",
      name: "Does converting between formats reduce quality?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Converting from PNG to lossless formats keeps original pixel data intact. Converting between lossy formats (JPEG to WebP/AVIF) re-encodes pixels, so setting quality to 85%+ or matching target size is recommended.",
      },
    },
    {
      "@type": "Question",
      name: "How does the Merge All feature work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Merge All arranges all your loaded images into a balanced square grid (e.g., 4 images become a 2x2 grid) on a clean white canvas, exporting a single consolidated image ready for download.",
      },
    },
    {
      "@type": "Question",
      name: "Can I batch process and download images as a ZIP?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes! Drag and drop multiple images at once, customize individual or bulk settings, and click \"ZIP All\" (or \"ZIP Selected\") to bundle everything into a single archive.",
      },
    },
    {
      "@type": "Question",
      name: "Does ImageWrangler work offline?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Once loaded, ImageWrangler requires no internet connection. All processing logic and workers run locally on your device.",
      },
    },
    {
      "@type": "Question",
      name: "What are the maximum resolution and file size limits?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Files up to 100MB and resolutions up to 15,000 × 15,000 pixels (50 megapixels) are supported. These limits prevent memory exhaustion and browser tab crashes.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color-meta" name="theme-color" content="#faf9f5" />
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = stored ? stored === 'dark' : prefersDark;
          if (isDark) {
            document.documentElement.classList.add('dark');
            var meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', '#141413');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Ashutosh (https://github.com/Ashutoshgit47)" />
    <meta
      name="keywords"
      content="image compressor, image resizer, image converter, offline image tool, privacy, batch image processing, avif, avif compressor, avif converter, jpg, png, webp, bmp, client-side, no upload, free image tool"
    />
    <link rel="canonical" href={appUrl} />
    <meta
      name="google-site-verification"
      content="5jhD5jimxXLLwDPE3Tf0DTh3f5Fziy0CVbkLmWwKbMU"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={appUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ImageWrangler" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ImageWrangler — compress, resize & convert images offline" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
